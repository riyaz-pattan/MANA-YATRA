{
  "rules": {
    ".read": "false",
    ".write": "false",
    "ride_signals": {
      "$vehicleType": {
        "$geohash": {
          ".read": "auth != null",
          ".write": false
        }
      }
    },
    "ride_declines": {
      "$rideId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "liveLocations": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId"
      }
    }
  }
}