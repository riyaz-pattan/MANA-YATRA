{
  "rules": {
    ".read": false,
    ".write": false,

    "config": {
      ".read": true,
      ".write": "auth != null && (auth.token.role === 'super_admin' || auth.token.role === 'operations_manager')"
    },

    "active_rides": {
      "$rideId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['status'])"
      }
    },
    
    "active_bids": {
      "$rideId": {
        ".read": "auth != null",
        "$driverId": {
          ".write": "auth != null && $driverId === auth.uid",
          ".validate": "root.child('active_rides').child($rideId).child('status').val() === 'searching' && newData.hasChildren(['price', 'status']) && newData.child('price').isNumber()"
        }
      }
    },

    "ride_signals": {
      "$vehicleType": {
        ".validate": "$vehicleType === 'auto' || $vehicleType === 'bike'",
        "$geohash": {
          ".read": "auth != null",
          ".write": false,
          ".validate": "newData.hasChildren(['rideId', 'riderId', 'createdAt'])",
          ".indexOn": [
            "createdAt"
          ]
        }
      }
    },

    "ride_declines": {
      "$rideId": {
        ".read": "auth != null",
        "$driverId": {
          ".write": "auth != null && auth.uid === $driverId",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "liveLocations": {
      ".read": "auth != null && auth.token.admin === true",
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $driverId",
        ".validate": "newData.hasChildren(['lat', 'lng']) && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "dashboard_stats": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },

    "operations": {
      ".read": false,
      ".write": false
    },
    
    "rate_limits": {
      ".read": false,
      ".write": false
    }
  }
}
