rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }

    // Drivers
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == driverId;
      allow update: if request.auth.uid == driverId &&
        (request.resource.data.isOnline == false ||
          (resource.data.isApproved == true &&
           resource.data.isBlocked == false &&
           resource.data.subscriptionActiveUntil > request.time));
    }

    // Rides
    match /rides/{rideId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.riderId;
      allow update: if request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId;
    }

    // Bids
    match /bids/{bidId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.driverId;
      allow update: if request.auth.uid == resource.data.driverId ||
                       request.auth.uid == resource.data.riderId;
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if request.auth.uid == resource.data.driverId;
      allow create: if request.auth.uid == request.resource.data.driverId;
    }

    // Admin-only: admin collection
    match /admin/{docId} {
      allow read, write: if request.auth.token.admin == true;
    }
  }
}