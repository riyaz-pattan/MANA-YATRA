rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Admin Access
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Users — schema-validated
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow update: if request.auth.uid == userId
        // Prevent users from modifying their own UID or role fields
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'role', 'createdAt']));
    }

    // Drivers — schema-validated
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == driverId
        && request.resource.data.keys().hasAll(['name', 'phone', 'vehicleType'])
        && request.resource.data.vehicleType in ['auto', 'bike'];
      // Drivers can update their own doc. For going online:
      // must be approved, not blocked, and have active subscription.
      // Going offline (isOnline == false) is always allowed.
      // Location updates (lat, lng, geohash) are always allowed.
      // Drivers can NEVER modify their own isApproved, isBlocked, or subscriptionActiveUntil.
      allow update: if request.auth.uid == driverId &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isApproved', 'isBlocked', 'subscriptionActiveUntil', 'createdAt'])) &&
        (
          // Always allow going offline or location updates
          request.resource.data.isOnline == false ||
          // Allow going online only if approved + not blocked + subscription active
          (resource.data.isApproved == true &&
           resource.data.isBlocked != true &&
           resource.data.subscriptionActiveUntil > request.time)
        );
    }

    // Rides — schema-validated creation
    match /rides/{rideId} {
      allow read: if request.auth != null;
      // Only the rider can create their own ride, with required fields
      allow create: if request.auth.uid == request.resource.data.riderId
        && request.resource.data.keys().hasAll(['riderId', 'status', 'vehicleType', 'pickupLat', 'pickupLng', 'dropLat', 'dropLng'])
        && request.resource.data.status == 'searching'
        && request.resource.data.vehicleType in ['auto', 'bike']
        && request.resource.data.pickupLat is number
        && request.resource.data.pickupLng is number
        && request.resource.data.dropLat is number
        && request.resource.data.dropLng is number;
      // Rider or assigned driver can update, EXCEPT the status field.
      // Status transitions (matched, started, completed, cancelled) MUST use Cloud Functions.
      // We allow updates only if the status field is not being changed.
      allow update: if (request.auth.uid == resource.data.riderId ||
                        request.auth.uid == resource.data.driverId)
                    && request.resource.data.status == resource.data.status;
    }

    // Bids — hardened with price cap validation
    match /bids/{bidId} {
      allow read: if request.auth != null;
      
      // Only drivers can create bids, with validation:
      allow create: if request.auth.uid == request.resource.data.driverId
        // Must have required fields
        && request.resource.data.keys().hasAll(['rideId', 'riderId', 'driverId', 'price', 'status'])
        // Status must start as 'pending'
        && request.resource.data.status == 'pending'
        // Price must be a positive number and capped (prevent abuse)
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.price <= 50000;

      // Update rules:
      // - Drivers can only withdraw their own bids
      // - Riders can accept/reject bids on their rides
      allow update: if 
        // Driver can only set status to 'withdrawn'
        (request.auth.uid == resource.data.driverId &&
         request.resource.data.status == 'withdrawn') ||
        // Rider can only REJECT bids (Accepting MUST go through Cloud Functions)
        (request.auth.uid == resource.data.riderId &&
         request.resource.data.status == 'rejected');
    }

    // Payments — scoped reads, driver-only creation with validation
    match /payments/{paymentId} {
      allow read: if request.auth.uid == resource.data.driverId ||
                     request.auth.uid == resource.data.riderId;
      allow create: if request.auth.uid == request.resource.data.driverId
        && request.resource.data.keys().hasAll(['rideId', 'driverId', 'riderId', 'amount'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
    }

    // Notifications log — read only for authenticated users
    match /notifications_log/{logId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write
    }

    // Account deletion requests — scoped to own requests
    match /account_deletion_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'role', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['rider', 'driver'];
      // Only admin (Cloud Functions) can update
    }

    // Operations (idempotency records) — admin-only
    match /operations/{opId} {
      allow read, write: if false;
      // Only Cloud Functions (admin SDK) can read/write
    }

    // Rate limits — admin-only
    match /rate_limits/{docId} {
      allow read, write: if false;
      // Only Cloud Functions (admin SDK) can read/write
    }

    // Admin-only: admin collection
    match /admin/{docId} {
      allow read, write: if request.auth.token.admin == true;
    }
  }
}