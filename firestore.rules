rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // RBAC HELPER FUNCTIONS
    // ============================================================

    // Check if the user has any valid admin role
    function isAdmin() {
      return request.auth != null && request.auth.token.role != null
        && request.auth.token.role in [
          'super_admin',
          'operations_manager',
          'finance_manager',
          'support_executive',
          'business_analyst',
          'viewer'
        ];
    }

    function hasRole(role) {
      return request.auth != null
        && request.auth.token.role == role;
    }

    function hasAnyRole(roles) {
      return request.auth != null
        && request.auth.token.role != null
        && request.auth.token.role in roles;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    // ============================================================
    // GLOBAL ADMIN OVERRIDE (backwards-compat + RBAC)
    // Super admins get full read/write on everything.
    // Legacy admin == true also still works for migration period.
    // ============================================================
    match /{document=**} {
      allow read, write: if isSuperAdmin()
        || (request.auth != null && request.auth.token.admin == true);
    }

    // ============================================================
    // ADMIN USERS COLLECTION
    // Super Admin: RW | Others: R (self only)
    // ============================================================
    match /admin_users/{adminId} {
      // Super admin can read all; other admin roles can only read their own doc
      allow read: if isSuperAdmin()
        || (hasAnyRole(['operations_manager', 'finance_manager', 'support_executive'])
            && request.auth.uid == adminId);
      // Only super admin can create/update/delete admin users
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // USERS — schema-validated (preserved existing + RBAC overlay)
    // Super Admin: RW | Ops: RW | Finance/Support/Analyst/Viewer: R
    // ============================================================
    match /users/{userId} {
      // Existing: any auth user can read. Admin roles also get read.
      allow read: if request.auth != null;
      // Admin write: super_admin (global override) + operations_manager
      allow write: if hasRole('operations_manager');
      // Existing rider rules: create own profile
      allow create: if request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      // Existing rider rules: update own profile (restricted fields)
      allow update: if request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'role', 'createdAt']));
    }

    // ============================================================
    // DRIVERS — schema-validated (preserved existing + RBAC overlay)
    // Super Admin: RW | Ops: RW | Finance/Support/Analyst/Viewer: R
    // ============================================================
    match /drivers/{driverId} {
      // Existing: any auth user can read. Admin roles also get read.
      allow read: if request.auth != null;
      // Admin write: operations_manager
      allow write: if hasRole('operations_manager');
      // Existing driver rules: create own profile
      allow create: if request.auth.uid == driverId
        && request.resource.data.keys().hasAll(['name', 'phone', 'vehicleType'])
        && request.resource.data.vehicleType in ['auto', 'bike'];
      // Existing driver rules: update own profile (with business logic)
      allow update: if request.auth.uid == driverId &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isApproved', 'isBlocked', 'subscriptionActiveUntil', 'createdAt'])) &&
        (
          request.resource.data.isOnline == false ||
          (resource.data.isApproved == true &&
           resource.data.isBlocked != true &&
           resource.data.subscriptionActiveUntil > request.time)
        );
    }

    // ============================================================
    // RIDES — schema-validated creation (preserved existing + RBAC overlay)
    // Super Admin: RW | Ops: RW | Finance/Support/Analyst/Viewer: R
    // ============================================================
    match /rides/{rideId} {
      // Existing: any auth user can read
      allow read: if request.auth != null;
      // Admin write: operations_manager
      allow write: if hasRole('operations_manager');
      // Existing rider rules: create ride
      allow create: if request.auth.uid == request.resource.data.riderId
        && request.resource.data.keys().hasAll(['riderId', 'status', 'vehicleType', 'pickup', 'drop'])
        && request.resource.data.status == 'searching'
        && request.resource.data.vehicleType in ['auto', 'bike']
        && request.resource.data.pickup.lat is number
        && request.resource.data.pickup.lng is number
        && request.resource.data.drop.lat is number
        && request.resource.data.drop.lng is number;
      // Existing: rider or driver can update
      // Driver: toggle payment_pending/started OR set driverArrived during matched
      allow update: if (request.auth.uid == resource.data.riderId ||
                        request.auth.uid == resource.data.driverId)
                    && (request.resource.data.status == resource.data.status || 
                       (request.auth.uid == resource.data.driverId && 
                        (resource.data.status == 'started' || resource.data.status == 'payment_pending') &&
                        (request.resource.data.status == 'payment_pending' || request.resource.data.status == 'started'))
                    )
                    // Driver can set driverArrived during matched (status stays same)
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['driverArrived', 'driverArrivedAt'])
                      || (request.auth.uid == resource.data.driverId && resource.data.status == 'matched')
                    );
    }

    // ============================================================
    // BIDS — hardened with price cap validation (preserved + RBAC)
    // Super Admin: RW | Ops: RW | Finance: R | Analyst/Viewer: R
    // ============================================================
    match /bids/{bidId} {
      // Admin read: ops, finance, analyst, viewer
      allow read: if request.auth != null
        || hasAnyRole(['operations_manager', 'finance_manager', 'business_analyst', 'viewer']);
      // Admin write: operations_manager
      allow write: if hasRole('operations_manager');
      // Existing driver rules: create bid
      allow create: if request.auth.uid == request.resource.data.driverId
        && request.resource.data.keys().hasAll(['rideId', 'riderId', 'driverId', 'price', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.price <= 50000;
      // Existing: driver withdraw or rider reject
      allow update: if
        (request.auth.uid == resource.data.driverId &&
         request.resource.data.status == 'withdrawn') ||
        (request.auth.uid == resource.data.riderId &&
         request.resource.data.status == 'rejected');
    }

    // ============================================================
    // PAYMENTS — scoped reads (preserved + RBAC)
    // Super Admin: RW | Ops: R | Finance: RW | Support/Analyst/Viewer: R
    // ============================================================
    match /payments/{paymentId} {
      // Existing rider/driver scoped read
      allow read: if request.auth.uid == resource.data.driverId ||
                     request.auth.uid == resource.data.riderId;
      // Admin read: all admin roles can read
      allow read: if hasAnyRole(['operations_manager', 'finance_manager',
                                  'support_executive', 'business_analyst', 'viewer']);
      // Admin write: finance_manager
      allow write: if hasRole('finance_manager');
      // Existing driver rules: create payment
      allow create: if request.auth.uid == request.resource.data.driverId
        && request.resource.data.keys().hasAll(['rideId', 'driverId', 'riderId', 'amount'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
    }

    // ============================================================
    // SUPPORT TICKETS (new collection)
    // Super Admin: RW | Ops: R | Support Exec: RW | Analyst/Viewer: R
    // ============================================================
    match /support_tickets/{ticketId} {
      allow read: if hasAnyRole(['operations_manager', 'support_executive',
                                  'business_analyst', 'viewer']);
      allow write: if hasRole('support_executive');
      // Riders/drivers can create support tickets for themselves
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'subject', 'status'])
        && request.resource.data.status == 'open';
      // Riders/drivers can read their own tickets
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ============================================================
    // SOS ALERTS (new collection)
    // Super Admin: RW | Ops: RW | Support: R | Analyst/Viewer: R
    // ============================================================
    match /sos_alerts/{alertId} {
      allow read: if hasAnyRole(['operations_manager', 'support_executive',
                                  'business_analyst', 'viewer']);
      allow write: if hasRole('operations_manager');
      // Riders/drivers can create SOS alerts
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'rideId', 'type']);
      // Riders/drivers can read their own SOS alerts
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // ZONES (new collection)
    // Super Admin: RW | Ops: RW | Analyst/Viewer: R
    // ============================================================
    match /zones/{zoneId} {
      allow read: if hasAnyRole(['operations_manager', 'business_analyst', 'viewer']);
      allow write: if hasRole('operations_manager');
    }

    // ============================================================
    // AUDIT LOGS (new collection) — append-only, read for all admins
    // All admin roles: R only | No client-side writes (admin SDK only)
    // ============================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
      // Only Cloud Functions (admin SDK) can write audit logs
    }

    // ============================================================
    // ADMIN STATS (new collection)
    // All admin roles: R | Cloud Functions: W
    // ============================================================
    match /admin_stats/{statId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // INCENTIVES (new collection)
    // Super Admin: RW | Ops: RW | Finance: RW | Analyst: R
    // ============================================================
    match /incentives/{incentiveId} {
      allow read: if hasAnyRole(['operations_manager', 'finance_manager',
                                  'business_analyst']);
      allow write: if hasAnyRole(['operations_manager', 'finance_manager']);
    }

    // ============================================================
    // ANNOUNCEMENTS (new collection)
    // Super Admin: RW | Ops: RW | Viewer: R
    // ============================================================
    match /announcements/{announcementId} {
      allow read: if hasAnyRole(['operations_manager', 'viewer']);
      allow write: if hasRole('operations_manager');
      // All authenticated users can read announcements (for in-app display)
      allow read: if request.auth != null;
    }

    // ============================================================
    // APP CONFIG (new collection)
    // Super Admin: RW | All other admins: R
    // ============================================================
    match /app_config/{configId} {
      allow read: if isAdmin();
      // Only super_admin can write (handled by global override)
      allow write: if false;
    }

    // ============================================================
    // REFERRAL CODES — lookup collection for referral program
    // Authenticated: R | Cloud Functions: W
    // ============================================================
    match /referral_codes/{code} {
      // Authenticated users can read (to validate codes)
      allow read: if request.auth != null;
      // Only Cloud Functions can write
      allow write: if false;
    }

    // ============================================================
    // REFERRALS — referral tracking records
    // Referrer: R (own) | Admin roles: R | Cloud Functions: W
    // ============================================================
    match /referrals/{referralId} {
      // Drivers can read their own referrals (as referrer)
      allow read: if request.auth != null 
        && resource.data.referrerDriverId == request.auth.uid;
      // Admin roles can read all
      allow read: if hasAnyRole(['operations_manager', 'finance_manager', 'business_analyst', 'viewer']);
      // Only Cloud Functions can write
      allow write: if false;
    }

    // ============================================================
    // REVIEWS (new collection)
    // ============================================================
    match /reviews/{reviewId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.riderId;
      allow read: if request.auth != null && (request.auth.uid == resource.data.riderId || request.auth.uid == resource.data.driverId);
      allow update, delete: if false;
    }

    // ============================================================
    // EXISTING COLLECTIONS (preserved as-is)
    // ============================================================

    // Notifications log — read only for authenticated users
    match /notifications_log/{logId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write
    }



    // Operations (idempotency records) — admin-only
    match /operations/{opId} {
      allow read, write: if false;
      // Only Cloud Functions (admin SDK) can read/write
    }

    // Rate limits — admin-only
    match /rate_limits/{docId} {
      allow read, write: if false;
      // Only Cloud Functions (admin SDK) can read/write
    }

    // Admin-only: legacy admin collection (backward compat)
    match /admin/{docId} {
      allow read, write: if isAdmin()
        || (request.auth != null && request.auth.token.admin == true);
    }
  }
}