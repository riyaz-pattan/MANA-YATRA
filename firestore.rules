rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }

    // Drivers
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == driverId;
      // Drivers can update their own doc. For going online:
      // must be approved, not blocked, and have active subscription.
      // Going offline (isOnline == false) is always allowed.
      // Location updates (lat, lng, geohash) are always allowed.
      allow update: if request.auth.uid == driverId &&
        (
          // Always allow going offline or location updates
          request.resource.data.isOnline == false ||
          // Allow going online only if approved + not blocked + subscription active
          (resource.data.isApproved == true &&
           resource.data.isBlocked != true &&
           resource.data.subscriptionActiveUntil > request.time)
        );
    }

    // Rides
    match /rides/{rideId} {
      allow read: if request.auth != null;
      // Only the rider can create their own ride
      allow create: if request.auth.uid == request.resource.data.riderId;
      // Rider or assigned driver can update. 
      // Cloud Functions (admin SDK) bypass rules for status transitions.
      allow update: if request.auth.uid == resource.data.riderId ||
                       request.auth.uid == resource.data.driverId;
    }

    // Bids — hardened with price cap validation
    match /bids/{bidId} {
      allow read: if request.auth != null;
      
      // Only drivers can create bids, with validation:
      allow create: if request.auth.uid == request.resource.data.driverId
        // Must have required fields
        && request.resource.data.keys().hasAll(['rideId', 'riderId', 'driverId', 'price', 'status'])
        // Status must start as 'pending'
        && request.resource.data.status == 'pending'
        // Price must be a positive number
        && request.resource.data.price is int
        && request.resource.data.price > 0;

      // Update rules:
      // - Drivers can only withdraw their own bids
      // - Riders can accept/reject bids on their rides
      allow update: if 
        // Driver can only set status to 'withdrawn'
        (request.auth.uid == resource.data.driverId &&
         request.resource.data.status == 'withdrawn') ||
        // Rider can update bid status (accept/reject)
        (request.auth.uid == resource.data.riderId &&
         request.resource.data.status in ['accepted', 'rejected']);
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if request.auth.uid == resource.data.driverId ||
                     request.auth.uid == resource.data.riderId;
      allow create: if request.auth.uid == request.resource.data.driverId;
    }

    // Notifications log — read only for authenticated users
    match /notifications_log/{logId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write
    }

    // Account deletion requests
    match /account_deletion_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Only admin (Cloud Functions) can update
    }

    // Admin-only: admin collection
    match /admin/{docId} {
      allow read, write: if request.auth.token.admin == true;
    }
  }
}